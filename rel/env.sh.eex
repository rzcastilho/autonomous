#!/bin/sh
# Sourced by bin/autonomous before every command (start, eval, remote).
#
# The entrypoint derives the instance identity (Autonomous.Instance) and exports
# it before `start`; `remote` is given the same variables by the wrapper. For the
# identity derivation itself (`eval`) neither exists yet, and the release defaults
# are fine because Instance.print_env/0 needs no distribution.
if [ -n "${AUTONOMOUS_NODE_NAME:-}" ]; then
  export RELEASE_DISTRIBUTION=sname
  export RELEASE_NODE="$AUTONOMOUS_NODE_NAME"
fi

# The cookie lives under the state root (0600), generated once per instance by the
# entrypoint — never in an image or a build arg.
if [ -n "${AUTONOMOUS_COOKIE_PATH:-}" ] && [ -f "$AUTONOMOUS_COOKIE_PATH" ]; then
  RELEASE_COOKIE="$(cat "$AUTONOMOUS_COOKIE_PATH")"
  export RELEASE_COOKIE
fi
