# Reference .env skeleton for `scripts/autonomous-container.sh` (contracts/environment.md §7).
# Copy to autonomous.env, fill in the values, then:
#   scripts/autonomous-container.sh start --env-file ./autonomous.env
#
# NOT written by hand — emitted by the launcher script from host values:
#   AUTONOMOUS_HOST_REPO, AUTONOMOUS_HOST_HOME, HOME, RELEASE_COOKIE

# --- required ---
SPECKIT_REPO=/home/alice/code/ledgerlite
ANTHROPIC_API_KEY=

# --- git identity (required in-container) ---
GIT_AUTHOR_NAME=Alice Example
GIT_AUTHOR_EMAIL=alice@example.com
GIT_COMMITTER_NAME=Alice Example
GIT_COMMITTER_EMAIL=alice@example.com

# --- optional ---
SPECKIT_MAX_CONCURRENCY=2
SPECKIT_BUDGET_USD=74.0
AUTONOMOUS_AUTOSTART=
AUTONOMOUS_CONSOLE_PORT=4000
ANTHROPIC_DEFAULT_OPUS_MODEL=
ANTHROPIC_DEFAULT_SONNET_MODEL=
GH_TOKEN=
