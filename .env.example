# Copy to .env (git-ignored) and fill in. Read by Compose at run time only —
# never a build arg, never baked into an image layer (FR-015).
#
# AUTONOMOUS_REPO and AUTONOMOUS_ROOT are IGNORED here: scripts/autonomous sets
# them from --target and the host $HOME.
# AUTONOMOUS_PR_WORKFLOW and AUTONOMOUS_MAX_CONCURRENCY are retired and must be
# ABSENT; the app refuses to boot when they are set.

# --- Agent credentials: one of the two, or start with --with-login ---------
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=

# --- Publishing (push + gh pr create) ---------------------------------------
GH_TOKEN=

# --- Commit identity (optional; overrides the Worktree defaults) ------------
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
GIT_COMMITTER_NAME=
GIT_COMMITTER_EMAIL=

# --- Model pins (recommended; a warning is printed when unset) --------------
ANTHROPIC_DEFAULT_OPUS_MODEL=
ANTHROPIC_DEFAULT_SONNET_MODEL=

# --- Release shape only: required, >= 64 bytes (openssl rand -base64 48) ----
AUTONOMOUS_SECRET_KEY_BASE=

# --- Console (optional) -----------------------------------------------------
# AUTONOMOUS_CONSOLE_HOST=localhost
# AUTONOMOUS_CONSOLE_PORT=4000

# --- Run settings (optional; per instance) ----------------------------------
# AUTONOMOUS_PR_BASE=main
# AUTONOMOUS_PR_REMOTE=origin
# AUTONOMOUS_PLAN_STACK=

# --- Desktop capability (optional) ------------------------------------------
# AUTONOMOUS_DISPLAY=1
# AUTONOMOUS_DISPLAY_VIEWER=1

# --- Android host-adb fallback (optional) -----------------------------------
# ADB_SERVER_SOCKET=tcp:host.docker.internal:5037
