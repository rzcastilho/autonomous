<% nav = Autonomous.Web.Layouts.nav_items() %>
<% escalations = Autonomous.Web.Layouts.escalations_count() %>
<% ctx = Autonomous.Web.Layouts.context() %>
<% run = Autonomous.Web.Layouts.run_view() %>
<div class="app-frame">
  <aside class="console-sidebar">
    <div class="console-logo">
      <div class="console-logo-mark"><div class="console-logo-mark-inner"></div></div>
      <div>
        <div class="console-brand-name">autonomous</div>
        <div class="console-brand-sub">Control plane · v1</div>
      </div>
    </div>

    <nav class="console-nav" aria-label="Console navigation">
      <a
        :for={{path, label} <- nav}
        href={path}
        class={["nav-item", assigns[:current_path] == path && "nav-active"]}
        aria-label={label}
        title={label}
      >
        <span class="nav-short" aria-hidden="true">{Autonomous.Web.Layouts.short_label(path)}</span>
        <span class="nav-label">{label}</span>
        <.badge
          :if={label == "Escalations" and escalations > 0}
          text={to_string(escalations)}
          variant={:warn}
        />
      </a>
    </nav>

    <div class="console-footer">
      <div class="console-footer-label">Target repo</div>
      <div class="console-footer-value">
        <span class="console-repo-path" data-repo-path={ctx.repo} title={ctx.repo}>
          {Path.basename(ctx.repo)}
        </span>
        <button
          type="button"
          class="btn-link"
          data-copy={ctx.repo}
          aria-label="Copy repository path"
          phx-click={Phoenix.LiveView.JS.dispatch("phx:copy", detail: %{text: ctx.repo})}
        >
          copy
        </button>
      </div>
      <div class="console-status-row">
        <span class="status-dot" data-health={ctx.cli_auth}></span>
        <span>claude CLI · <span class="console-status-value">{ctx.cli_auth}</span></span>
      </div>
      <div class="console-status-row">
        <span class="status-dot" data-health={ctx.runtime}></span>
        <span>BEAM · <span class="console-status-value">{ctx.runtime}</span></span>
      </div>
    </div>
  </aside>

  <div class="content-column console-main">
    <header class="console-topbar" data-active={run.active?} data-parked={run.parked?}>
      <div class="topbar-run">
        <%= cond do %>
          <% run.parked? -> %>
            <span class="run-state-chip run-state-parked">parked</span>
            <div class="run-info">
              <div class="run-title">{run.title}</div>
            </div>
          <% run.active? -> %>
            <span class="run-state-chip run-state-active">● live</span>
            <div class="run-info">
              <div class="run-title">{run.title}</div>
            </div>
          <% true -> %>
            <span class="run-state-chip run-state-idle">idle</span>
            <div class="run-info">
              <div class="run-title run-title-empty">{run.title}</div>
            </div>
        <% end %>
      </div>

      <div class="topbar-divider"></div>

      <%= if run.active? do %>
        <span class="topbar-spend" data-spend>
          <span class="topbar-spend-label">spend</span>
          ${Autonomous.Web.CoreComponents.format_money(run.spend)}
        </span>
      <% end %>

      <div class="topbar-clock">
        <span id="console-clock">{run.clock} UTC</span>
      </div>
    </header>

    <div class="console-content">
      {@inner_content}
    </div>

    <div class="console-toasts" id="console-toasts">
      <.toast
        :for={{kind, message} <- @flash}
        id={"flash-#{kind}"}
        kind={String.to_existing_atom(kind)}
        message={message}
      />
      <.toast :for={t <- assigns[:toasts] || []} id={t.id} kind={t.kind} message={t.message} />
    </div>

    <!-- Drawer slot: filled by FeatureDrawerComponent in a later phase. -->
    <div class="console-drawer-slot" id="console-drawer-slot"></div>
  </div>
</div>
