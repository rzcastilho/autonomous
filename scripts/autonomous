#!/bin/sh
# The documented entry point for operating the orchestrator (feature 031, FR-003).
# Contract: specs/031-containerized-runtime/contracts/wrapper-cli.md
#
#   scripts/autonomous build [--release] [--web] [--desktop] [--android] [--apt "<pkg> ..."] [--agent-root] [--docker]
#   scripts/autonomous shell   --target <repo> [--port <n>] [--with-login] [--docker]
#   scripts/autonomous console --target <repo> [--port <n>] [--with-login] [--docker]
#   scripts/autonomous release --target <repo> [--port <n>] [--with-login] [--docker]
#   scripts/autonomous remote  --target <repo>
#   scripts/autonomous port    --target <repo>
#   scripts/autonomous stop    --target <repo> [--purge]
#   scripts/autonomous volumes --target <repo> [--init]
#   scripts/autonomous reset-cache --target <repo> [--volume <name>]... [--engine]
#   scripts/autonomous viewer  --target <repo>
#   scripts/autonomous test  [mix test args]
#
# Requires Docker Engine + Compose v2 on Linux (other engines are unsupported).
# Exit codes: 2 usage, 3 not Compose v2, 4 target not a git repo, 5 image not
# built, 75 target already served, 76 console port busy, 77 the container-engine
# sidecar could not start, 78 the engine was not ready in time (--docker, feature 046).
set -eu

root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root"

DEV_IMAGE="autonomous-dev:local"
RELEASE_IMAGE="autonomous-release:local"

say() { printf 'autonomous: %s\n' "$*"; }
err() { printf 'autonomous: %s\n' "$*" >&2; }
die() { code="$1"; shift; err "$*"; exit "$code"; }

usage() {
  cat >&2 <<'EOF'
usage: scripts/autonomous <command> [options]

  build [--release] [--web] [--desktop] [--android] [--apt "<pkg> ..."] [--agent-root] [--docker]
                                         build the dev image (autonomous-dev:local); --release also
                                         builds autonomous-release:local; --web/--desktop/--android
                                         add the opt-in testing capabilities (default: none)
  shell --target <repo> [--port <n>]     interactive iex with the console served
  console --target <repo> [--port <n>]   detached console (Phoenix server)
  release --target <repo> [--port <n>]   detached release instance (needs build --release)
  remote  --target <repo>                remote console into a running release
  port  --target <repo>                  print the console address of a running instance
  viewer --target <repo>                 print the desktop viewer address of a running --viewer instance
  stop  --target <repo> [--purge]        stop the instance; --purge also removes build volumes and
                                         declared volumes
  volumes --target <repo> [--init]       print the target's volume declaration path, entries and
                                         validation result; --init writes a commented starter file
  reset-cache --target <repo> [--volume <name>]... [--engine]
                                         remove declared volumes of a stopped instance (all when no
                                         --volume); --engine removes the engine storage volume
  test  [mix test args]                  run the test suite inside the dev image

options:
  --agent-root                           build passwordless sudo into the image so agent sessions may
                                         `sudo apt-get install` missing packages (build only)
  --apt <list>                           system packages to install into the image at build time
                                         (repeatable; space/comma separated; build only)
  --docker                               container engine for sessions (feature 046): on build, install the
                                         docker client and build the engine sidecar image; on shell/console/
                                         release, start the rootless engine sidecar (needs an image built
                                         with --docker; Compose >= 2.24.4)
  --engine                               reset-cache only: remove the engine storage volume
  --with-login                           mount the host agent login (opt-in)
  --viewer                               serve the virtual display through noVNC on loopback
                                         (needs an image built with --desktop)
  --android                              Android support at start: pass /dev/kvm through when present
                                         (needs an image built with --android)
EOF
  exit 2
}

[ "$#" -ge 1 ] || usage
cmd="$1"
shift

target=""
port=""
with_login=0
purge=0
init=0
volume_names=""
build_release=0
with_web=0
with_desktop=0
with_android=0
viewer=0
apt_packages=""
with_agent_root=0
with_docker=0
reset_engine=0
test_args=""

# Validate and accumulate one --apt value (feature 037). Runs at parse time so a
# bad name is refused before any docker call.
add_apt() {
  set -f
  for tok in $(printf '%s' "$1" | tr ',' ' '); do
    printf '%s' "$tok" | grep -Eq '^[a-z0-9][a-z0-9+.-]+(:[a-z0-9-]+)?(=[A-Za-z0-9.+~:-]+)?$' \
      || { set +f; die 2 "invalid package name '$tok'"; }
    apt_packages="${apt_packages:+$apt_packages }$tok"
  done
  set +f
}

case "$cmd" in
  build | shell | console | release | remote | port | viewer | stop | volumes | reset-cache | test) ;;
  -h | --help | help) usage ;;
  *) err "unknown command '$cmd'"; usage ;;
esac

if [ "$cmd" = "test" ]; then
  # Everything after `test` belongs to mix test.
  :
else
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --target) [ "$#" -ge 2 ] || usage; target="$2"; shift 2 ;;
      --target=*) target="${1#--target=}"; shift ;;
      --port) [ "$#" -ge 2 ] || usage; port="$2"; shift 2 ;;
      --port=*) port="${1#--port=}"; shift ;;
      --with-login) with_login=1; shift ;;
      --purge) purge=1; shift ;;
      --volume)
        [ "$cmd" = reset-cache ] || { err "unknown option '$1'"; usage; }
        [ "$#" -ge 2 ] || usage
        volume_names="${volume_names:+$volume_names }$2"; shift 2 ;;
      --volume=*)
        [ "$cmd" = reset-cache ] || { err "unknown option '$1'"; usage; }
        volume_names="${volume_names:+$volume_names }${1#--volume=}"; shift ;;
      --init)
        [ "$cmd" = volumes ] || { err "unknown option '$1'"; usage; }
        init=1; shift ;;
      --release) build_release=1; shift ;;
      --web) with_web=1; shift ;;
      --desktop) with_desktop=1; shift ;;
      --android) with_android=1; shift ;;
      --viewer) viewer=1; shift ;;
      --docker)
        case "$cmd" in build | shell | console | release) ;; *) err "unknown option '$1'"; usage ;; esac
        with_docker=1; shift ;;
      --engine)
        [ "$cmd" = reset-cache ] || { err "unknown option '$1'"; usage; }
        reset_engine=1; shift ;;
      --agent-root)
        [ "$cmd" = build ] || { err "unknown option '$1'"; usage; }
        with_agent_root=1; shift ;;
      --apt)
        [ "$cmd" = build ] || { err "unknown option '$1'"; usage; }
        [ "$#" -ge 2 ] || usage
        add_apt "$2"; shift 2 ;;
      --apt=*)
        [ "$cmd" = build ] || { err "unknown option '$1'"; usage; }
        add_apt "${1#--apt=}"; shift ;;
      *) err "unknown option '$1'"; usage ;;
    esac
  done
fi

# ---- engine ----------------------------------------------------------------------
compose_version="$(docker compose version --short 2>/dev/null || true)"
compose_major="$(printf '%s' "$compose_version" | sed 's/^v//' | cut -d. -f1)"
case "$compose_major" in
  '' | *[!0-9]*) die 3 "Docker Compose v2 is required (found: ${compose_version:-none}); other engines are unsupported" ;;
esac
[ "$compose_major" -ge 2 ] \
  || die 3 "Docker Compose v2 is required (found: $compose_version); other engines are unsupported"

# Version gate for the container-engine overlay (`!reset`, `up --wait-timeout`).
compose_at_least() { # compose_at_least <major.minor.patch>
  cal_have="$(printf '%s' "$compose_version" | sed 's/^v//; s/[^0-9.].*//')"
  [ "$(printf '%s\n%s\n' "$1" "$cal_have" | sort -t. -k1,1n -k2,2n -k3,3n | head -n1)" = "$1" ]
}
if [ "$with_docker" = 1 ]; then
  compose_at_least 2.24.4 \
    || die 3 "--docker needs Docker Compose >= 2.24.4 (found: $compose_version)"
fi

# ---- environment shared by every compose call ------------------------------------
state_root="$HOME/.autonomous"
# Bind-mount sources must exist: Docker would otherwise create them root-owned.
mkdir -p "$state_root" "$root/_build" "$root/deps"

AUTONOMOUS_UID="$(id -u)"
AUTONOMOUS_GID="$(id -g)"
AUTONOMOUS_ROOT="$state_root"
export AUTONOMOUS_UID AUTONOMOUS_GID AUTONOMOUS_ROOT

if [ -f .env ] && grep -Eq '^(AUTONOMOUS_REPO|AUTONOMOUS_ROOT)=' .env; then
  err "warning: .env sets AUTONOMOUS_REPO/AUTONOMOUS_ROOT; ignored (the wrapper sets them from --target and \$HOME)"
fi

compose_files="-f compose.yaml"
if [ "$with_login" = 1 ]; then
  # Missing sources would be created root-owned by Docker.
  [ -d "$HOME/.claude" ] && [ -f "$HOME/.claude.json" ] \
    || die 2 "--with-login needs \$HOME/.claude and \$HOME/.claude.json (log in with the agent CLI on the host first)"
  compose_files="$compose_files -f compose.claude-login.yaml"
fi

# With the engine sidecar the viewer port lives on the sidecar (compose.engine-viewer.yaml,
# added with the engine overlay) because the agent services share its network namespace.
if [ "$viewer" = 1 ] && [ "$with_docker" != 1 ]; then
  compose_files="$compose_files -f compose.desktop-viewer.yaml"
fi
if [ "$with_android" = 1 ] && [ "$cmd" != build ]; then
  if [ -c /dev/kvm ] && [ -r /dev/kvm ] && [ -w /dev/kvm ]; then
    AUTONOMOUS_KVM_GID="$(stat -c '%g' /dev/kvm)"
    export AUTONOMOUS_KVM_GID
    compose_files="$compose_files -f compose.android.yaml"
  else
    err "warning: /dev/kvm is not usable here; Android sessions need the host adb fallback (see docs/container.md)"
  fi
fi

require_image() {
  docker image inspect "$1" >/dev/null 2>&1 \
    || die 5 "image $1 not found; run scripts/autonomous build"
}

resolve_target() {
  [ -n "$target" ] || { err "--target is required"; usage; }
  [ -d "$target" ] || die 4 "target $target is not a git repository"
  target="$(cd "$target" && pwd -P)"
  git -C "$target" rev-parse --git-dir >/dev/null 2>&1 \
    || die 4 "target $target is not a git repository"
  AUTONOMOUS_REPO="$target"
  export AUTONOMOUS_REPO
}

port_busy() {
  python3 -c '
import socket, sys
s = socket.socket()
try:
    s.bind(("127.0.0.1", int(sys.argv[1])))
except OSError:
    sys.exit(0)
sys.exit(1)
' "$1"
}

free_port() {
  python3 -c '
import socket
s = socket.socket()
s.bind(("127.0.0.1", 0))
print(s.getsockname()[1])
'
}

# The identity is derived in Elixir only (never recomputed in shell): ask the
# image, under a fixed bootstrap project, via the entrypoint's `identity` command.
lookup_identity() { # lookup_identity [dev|release]
  AUTONOMOUS_HOST_PORT="" docker compose -p autonomous-bootstrap $compose_files \
    run --rm --no-deps -T "${1:-dev}" identity | grep '^AUTONOMOUS_'
}

env_value() { printf '%s\n' "$1" | sed -n "s/^$2=//p"; }

# Feature 041: the host-only volume declaration for one instance (research.md R1).
# Sets $volumes_file to ${XDG_CONFIG_HOME:-$HOME/.config}/autonomous/targets/<segment>/volumes.toml.
# Refuses (2) when the resolved parent is inside the state root, the target repo,
# or the orchestrator source tree: a session must never be able to read or edit it.
volumes_declaration_path() { # volumes_declaration_path <segment>
  vd_dir="${XDG_CONFIG_HOME:-$HOME/.config}/autonomous/targets/$1"
  vd_real="$(python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "$vd_dir")" \
    || die 1 "could not resolve $vd_dir"
  vd_state="$(python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "$HOME/.autonomous")"
  for vd_guard in "$vd_state" "${AUTONOMOUS_REPO:-}" "$root"; do
    [ -n "$vd_guard" ] || continue
    case "$vd_real/" in
      "$vd_guard"/*)
        die 2 "$vd_real/volumes.toml is inside $vd_guard; set XDG_CONFIG_HOME outside the state root, the target repo and the orchestrator source" ;;
    esac
  done
  volumes_file="$vd_real/volumes.toml"
}

# Feature 041: instance context handed to volumes.py (container-side paths; the
# repo path is the same inside and outside). $1 = image whose environment feeds
# the PATH composition and the override notices.
volumes_context() { # volumes_context <image> <worktree_root> <segment>
  vc_env="$(docker image inspect -f '{{json .Config.Env}}' "$1" 2>/dev/null || true)"
  python3 -c '
import json, sys
a = sys.argv
print(json.dumps({
    "repo": a[1], "worktree_root": a[2], "segment": a[3],
    "uid": int(a[4]), "gid": int(a[5]),
    "image_env": json.loads(a[6]) if a[6].strip() else [],
}))
' "$AUTONOMOUS_REPO" "$2" "$3" "$AUTONOMOUS_UID" "$AUTONOMOUS_GID" "$vc_env"
}

# Step 2* of the start sequence (wrapper-cli.md): validate the declaration before
# anything exists. Sets $volumes_records (empty when there is nothing to apply).
# Absent file: no volumes.py call, no output (FR-004).
volumes_records=""
volumes_ctx=""
volumes_prepare() { # volumes_prepare <image>
  volumes_declaration_path "$segment"
  [ -f "$volumes_file" ] || return 0
  volumes_ctx="$(volumes_context "$1" "$(env_value "$identity" AUTONOMOUS_WORKTREE_ROOT)" "$segment")"
  vp_rc=0
  volumes_records="$(python3 "$root/scripts/volumes.py" plan --declaration "$volumes_file" \
    --context "$volumes_ctx" --records)" || vp_rc=$?
  [ "$vp_rc" = 0 ] || exit "$vp_rc"
}

# Step 4*: create the labelled volumes, make their roots writable by the
# container user, write the overlay, report what was applied. No-op without
# volumes (zero docker calls, no output, no overlay).
volumes_apply() { # volumes_apply <image>
  [ -n "$volumes_records" ] || return 0
  tab="$(printf '\t')"
  va_mounts=""
  va_dirs=""
  va_notices=""
  va_lines=""
  nl="
"
  while IFS="$tab" read -r kind a b c d e; do
    case "$kind" in
      volume)
        docker volume create \
          --label "dev.autonomous.kind=user-volume" \
          --label "dev.autonomous.segment=$segment" \
          --label "dev.autonomous.volume=$a" "$b" >/dev/null \
          || die 1 "could not create volume $b"
        va_mounts="$va_mounts -v $b:/v/$a"
        va_dirs="$va_dirs /v/$a"
        va_lines="$va_lines$(printf 'volume %s -> %s (%s, %s)' "$a" "$c" "$d" "$e")$nl"
        ;;
      notice) va_notices="$va_notices$a$nl" ;;
    esac
  done <<VOLUMES_EOF
$volumes_records
VOLUMES_EOF
  # One provisioning container, non-recursive, every start (research.md R5).
  # shellcheck disable=SC2086
  docker run --rm --user 0:0 --entrypoint /bin/sh $va_mounts "$1" -c \
    'uid="$1"; gid="$2"; shift 2
     for d in "$@"; do
       [ "$(stat -c %u:%g "$d")" = "$uid:$gid" ] || chown "$uid:$gid" "$d"
     done' sh "$AUTONOMOUS_UID" "$AUTONOMOUS_GID" $va_dirs >/dev/null \
    || die 1 "could not prepare the declared volumes"
  volumes_overlay="$(dirname "$volumes_file")/applied.compose.json"
  python3 "$root/scripts/volumes.py" plan --declaration "$volumes_file" \
    --context "$volumes_ctx" --write-overlay "$volumes_overlay" >/dev/null \
    || die 1 "could not write $volumes_overlay"
  compose_files="$compose_files -f $volumes_overlay"
  say "volumes  $volumes_file"
  printf '%s' "$va_lines" | while IFS= read -r line; do [ -z "$line" ] || say "$line"; done
  printf '%s' "$va_notices" | while IFS= read -r line; do [ -z "$line" ] || say "$line"; done
}

# Sets $port: validates --port (76 when busy, FR-021) or picks a free loopback
# port, so the address can be printed before a foreground session takes the
# terminal.
choose_port() {
  if [ -n "$port" ]; then
    case "$port" in
      *[!0-9]*) die 2 "usage: --port expects a number" ;;
    esac
    if port_busy "$port"; then
      die 76 "console port $port is already in use on 127.0.0.1"
    fi
  else
    port="$(free_port)"
  fi
  AUTONOMOUS_HOST_PORT="$port"
  export AUTONOMOUS_HOST_PORT
}

print_summary() {
  say "target   $target"
  say "instance $node_name"
  say "console  http://127.0.0.1:$port/"
}

console_responds() {
  python3 -c '
import sys, urllib.request
try:
    urllib.request.urlopen("http://127.0.0.1:%s/" % sys.argv[1], timeout=2)
except Exception as e:
    # Any HTTP status means the endpoint is up; only connection errors mean not yet.
    sys.exit(0 if hasattr(e, "code") else 1)
' "$1" >/dev/null 2>&1
}

# Wait for a detached instance to serve the console, or to die. A target that is
# already served exits 75 in the entrypoint; surface that instead of timing out.
wait_for_console() { # wait_for_console <project> <service>
  deadline=$(( $(date +%s) + ${AUTONOMOUS_START_TIMEOUT:-900} ))
  say "waiting for the console (first start of a target builds its dependencies)..."
  while :; do
    # shellcheck disable=SC2086
    cid="$(docker compose -p "$1" $compose_files ps -aq "$2" 2>/dev/null | head -n1)"
    if [ -n "$cid" ]; then
      state="$(docker inspect -f '{{.State.Status}} {{.State.ExitCode}}' "$cid" 2>/dev/null || true)"
      case "$state" in
        exited* | dead*)
          code="${state#* }"
          # shellcheck disable=SC2086
          logs="$(docker compose -p "$1" $compose_files logs --no-log-prefix "$2" 2>&1 | tail -n 20)"
          if [ "$with_docker" = 1 ]; then
            # The agent is gone (e.g. the entrypoint's engine probe returned 78): do not
            # leave the sidecar running. No -v — the engine storage survives.
            # shellcheck disable=SC2086
            docker compose -p "$1" $compose_files down >/dev/null 2>&1 || true
          fi
          if [ "$code" = 75 ]; then
            err "$(printf '%s\n' "$logs" | grep 'already served' | tail -n1 | sed 's/^autonomous: //')"
            exit 75
          fi
          printf '%s\n' "$logs" >&2
          die "$code" "console instance exited with status $code"
          ;;
      esac
    fi
    console_responds "$port" && return 0
    [ "$(date +%s)" -lt "$deadline" ] || die 1 "console did not answer on 127.0.0.1:$port within ${AUTONOMOUS_START_TIMEOUT:-900}s"
    sleep 2
  done
}

# ---- container engine sidecar (feature 046, contracts/wrapper-cli.md) -------------
ENGINE_IMAGE="autonomous-engine:local"

# Preconditions, checked before any container or volume exists: the engine image is
# built (5) and the agent image carries the docker client + compose + buildx (5).
engine_preconditions() { # engine_preconditions <agent image>
  docker image inspect "$ENGINE_IMAGE" >/dev/null 2>&1 \
    || die 5 "image $ENGINE_IMAGE not found; run scripts/autonomous build --docker"
  docker run --rm --entrypoint sh "$1" -c \
    'command -v docker && docker compose version && docker buildx version' >/dev/null 2>&1 \
    || die 5 "image $1 has no docker client; run scripts/autonomous build --docker"
}

# Adds the sidecar overlay (and its viewer variant) once everything that needs the
# overlay-free file list (identity lookup) has run. $segment is exported because the
# overlay labels the storage volume with it.
engine_overlay() {
  AUTONOMOUS_INSTANCE_SEGMENT="$segment"
  export AUTONOMOUS_INSTANCE_SEGMENT
  compose_files="$compose_files -f compose.engine.yaml"
  if [ "$viewer" = 1 ]; then
    compose_files="$compose_files -f compose.engine-viewer.yaml"
  fi
}

# Removes the sidecar container; the engine storage volume is kept.
engine_remove() { # engine_remove <project>
  # shellcheck disable=SC2086
  docker compose -p "$1" $compose_files rm -sf engine >/dev/null 2>&1 || true
}

# Starts the sidecar and waits for its healthcheck within the bound. On any failure
# the sidecar is removed again and the start is refused: 76 (console port taken),
# 77 (the host runtime refused it) or 78 (not ready in time). Never degrades to
# starting without the engine (FR-012).
engine_up() { # engine_up <project>
  eu_bound="${AUTONOMOUS_ENGINE_TIMEOUT:-60}"
  eu_rc=0
  # shellcheck disable=SC2086
  eu_out="$(docker compose -p "$1" $compose_files up -d --no-build --pull never \
    --wait --wait-timeout "$eu_bound" engine 2>&1)" || eu_rc=$?
  [ "$eu_rc" != 0 ] || return 0

  # shellcheck disable=SC2086
  eu_logs="$(docker compose -p "$1" $compose_files logs --no-log-prefix --tail 20 engine 2>&1 || true)"
  engine_remove "$1"
  if printf '%s' "$eu_out" | grep -Eqi 'port is already allocated|address already in use'; then
    die 76 "console port $port is already in use on 127.0.0.1"
  fi
  if printf '%s\n%s' "$eu_out" "$eu_logs" | grep -Eqi 'privileged|operation not permitted|rootless|cannot be run in'; then
    printf '%s\n' "$eu_out" >&2
    die 77 "the container-engine sidecar could not start: the host runtime refused a privileged container. Run on Docker Engine (Linux) or Docker Desktop with privileged containers allowed"
  fi
  printf '%s\n' "$eu_out" >&2
  printf '%s\n' "$eu_logs" >&2
  die 78 "the container engine was not ready within ${eu_bound}s. Last engine log lines are above; reset a broken store with: scripts/autonomous reset-cache --target $target --engine, check host disk space, or raise AUTONOMOUS_ENGINE_TIMEOUT"
}

case "$cmd" in
  build)
    AUTONOMOUS_REPO="$root"
    export AUTONOMOUS_REPO
    services="dev"
    [ "$build_release" = 1 ] && services="dev release"
    if [ "$with_docker" = 1 ]; then
      # The client is a build arg (no-op unless 1); the sidecar image is its own service.
      WITH_DOCKER=1
      export WITH_DOCKER
      AUTONOMOUS_INSTANCE_SEGMENT="bootstrap"
      export AUTONOMOUS_INSTANCE_SEGMENT
      compose_files="$compose_files -f compose.engine.yaml"
      services="$services engine"
    fi
    # Capabilities are build args; each is a no-op in the Dockerfile unless 1.
    WITH_WEB="$with_web"; WITH_DESKTOP="$with_desktop"; WITH_ANDROID="$with_android"
    export WITH_WEB WITH_DESKTOP WITH_ANDROID
    EXTRA_APT_PACKAGES="$apt_packages"
    WITH_AGENT_ROOT="$with_agent_root"
    export EXTRA_APT_PACKAGES WITH_AGENT_ROOT
    # shellcheck disable=SC2086
    exec docker compose -p autonomous-bootstrap $compose_files build $services
    ;;

  test)
    require_image "$DEV_IMAGE"
    AUTONOMOUS_REPO="$root"
    export AUTONOMOUS_REPO
    tty_flag=""
    [ -t 0 ] || tty_flag="-T"
    # shellcheck disable=SC2086
    exec docker compose -p autonomous-test $compose_files \
      run --rm --no-deps $tty_flag dev test "$@"
    ;;

  stop)
    resolve_target
    require_image "$DEV_IMAGE"
    identity="$(lookup_identity)" || die 1 "could not derive the instance identity for $target"
    segment="$(env_value "$identity" AUTONOMOUS_INSTANCE_SEGMENT)"
    down_flags=""
    [ "$purge" = 1 ] && down_flags="-v"
    # Feature 046: an instance started with --docker owns an engine sidecar container.
    # Detect it by compose labels (running or exited) and take the overlay down with the
    # rest; without one, the `down` below is exactly the pre-046 call.
    engine_found="$(docker ps -a \
      --filter "label=com.docker.compose.project=autonomous-$segment" \
      --filter "label=com.docker.compose.service=engine" --format '{{.Names}}' 2>/dev/null | head -n1)"
    if [ -n "$engine_found" ]; then
      AUTONOMOUS_INSTANCE_SEGMENT="$segment"
      export AUTONOMOUS_INSTANCE_SEGMENT
      compose_files="$compose_files -f compose.engine.yaml"
    fi
    # shellcheck disable=SC2086
    docker compose -p "autonomous-$segment" $compose_files down $down_flags \
      || die 1 "could not stop the instance for $target"
    if [ "$purge" = 1 ]; then
      # Feature 046: the engine storage volume (images + build cache) of this segment.
      for pe in $(docker volume ls -q \
        --filter "label=dev.autonomous.kind=engine-storage" \
        --filter "label=dev.autonomous.segment=$segment" 2>/dev/null); do
        docker volume rm "$pe" >/dev/null || die 1 "could not remove volume $pe"
        say "$pe removed"
      done
      # Feature 041 (research.md R12): every labelled user volume of this segment,
      # declared or not. Plain `stop` touches none.
      for pv in $(docker volume ls -q \
        --filter "label=dev.autonomous.kind=user-volume" \
        --filter "label=dev.autonomous.segment=$segment" 2>/dev/null); do
        docker volume rm "$pv" >/dev/null || die 1 "could not remove volume $pv"
        say "$pv removed"
      done
    fi
    ;;

  reset-cache)
    resolve_target
    require_image "$DEV_IMAGE"

    identity="$(lookup_identity)" || die 1 "could not derive the instance identity for $target"
    segment="$(env_value "$identity" AUTONOMOUS_INSTANCE_SEGMENT)"
    [ -n "$segment" ] || die 1 "could not derive the instance identity for $target"
    project="autonomous-$segment"

    # Any container of the project, running or exited, still pins its volumes.
    pinned="$(docker ps -a --filter "label=com.docker.compose.project=$project" --format '{{.Names}}' | head -n1)"
    [ -z "$pinned" ] \
      || die 75 "target $target is served by $pinned; stop it first: scripts/autonomous stop --target $target"

    # Feature 046: --engine removes only the engine storage volume of this segment (images
    # and build cache). Declared volumes are left alone unless --volume is also given.
    engine_rc=0
    if [ "$reset_engine" = 1 ]; then
      engine_vols="$(docker volume ls -q \
        --filter "label=dev.autonomous.kind=engine-storage" \
        --filter "label=dev.autonomous.segment=$segment" 2>/dev/null)"
      if [ -z "$engine_vols" ]; then
        say "engine storage not present"
      else
        for ev in $engine_vols; do
          if docker volume rm "$ev" >/dev/null; then
            say "engine storage removed"
          else
            err "could not remove volume $ev"
            engine_rc=1
          fi
        done
      fi
      [ -n "$volume_names" ] || exit "$engine_rc"
    fi

    volumes_declaration_path "$segment"
    if [ ! -f "$volumes_file" ]; then
      say "no declared volumes"
      exit "$engine_rc"
    fi
    select_args=""
    for vn in $volume_names; do select_args="$select_args --volume $vn"; done
    sel_rc=0
    # shellcheck disable=SC2086
    selected="$(python3 "$root/scripts/volumes.py" select --declaration "$volumes_file" $select_args)" || sel_rc=$?
    [ "$sel_rc" = 0 ] || exit "$sel_rc"
    if [ -z "$selected" ]; then
      say "no declared volumes"
      exit "$engine_rc"
    fi

    rc="$engine_rc"
    for vn in $selected; do
      dn="autonomous-${segment}_vol-$vn"
      if ! docker volume inspect "$dn" >/dev/null 2>&1; then
        say "$vn not present"
        continue
      fi
      labels="$(docker volume inspect --format \
        '{{index .Labels "dev.autonomous.kind"}} {{index .Labels "dev.autonomous.segment"}} {{index .Labels "dev.autonomous.volume"}}' \
        "$dn" 2>/dev/null || true)"
      if [ "$labels" != "user-volume $segment $vn" ]; then
        err "volume $dn exists but is not labelled as a declared volume of this target; not removed"
        rc=1
        continue
      fi
      docker volume rm "$dn" >/dev/null || { err "could not remove volume $dn"; rc=1; continue; }
      say "$vn removed"
    done
    exit "$rc"
    ;;

  volumes)
    resolve_target
    require_image "$DEV_IMAGE"

    identity="$(lookup_identity)" || die 1 "could not derive the instance identity for $target"
    segment="$(env_value "$identity" AUTONOMOUS_INSTANCE_SEGMENT)"
    [ -n "$segment" ] || die 1 "could not derive the instance identity for $target"
    volumes_declaration_path "$segment"

    if [ "$init" = 1 ]; then
      exec python3 "$root/scripts/volumes.py" init --declaration "$volumes_file"
    fi

    present="$(docker volume ls -q \
      --filter "label=dev.autonomous.kind=user-volume" \
      --filter "label=dev.autonomous.segment=$segment" 2>/dev/null \
      | python3 -c 'import json, sys; print(json.dumps([l.strip() for l in sys.stdin if l.strip()]))')"
    ctx="$(volumes_context "$DEV_IMAGE" "$(env_value "$identity" AUTONOMOUS_WORKTREE_ROOT)" "$segment")"
    exec python3 "$root/scripts/volumes.py" show --declaration "$volumes_file" \
      --context "$ctx" --present "${present:-[]}"
    ;;

  shell)
    resolve_target
    require_image "$DEV_IMAGE"

    identity="$(lookup_identity)" || die 1 "could not derive the instance identity for $target"
    segment="$(env_value "$identity" AUTONOMOUS_INSTANCE_SEGMENT)"
    node_name="$(env_value "$identity" AUTONOMOUS_NODE_NAME)"
    [ -n "$segment" ] || die 1 "could not derive the instance identity for $target"

    [ "$with_docker" != 1 ] || engine_preconditions "$DEV_IMAGE"
    volumes_prepare "$DEV_IMAGE"
    choose_port
    print_summary
    volumes_apply "$DEV_IMAGE"

    tty_flag=""
    [ -t 0 ] || tty_flag="-T"
    if [ "$with_docker" = 1 ]; then
      # A foreground `run` cannot `exec`: the sidecar must be removed on every exit
      # path, so the wrapper stays alive and exits with the session's status.
      project="autonomous-$segment"
      engine_overlay
      trap 'engine_remove "$project"' EXIT
      engine_up "$project"
      sh_rc=0
      # shellcheck disable=SC2086
      docker compose -p "$project" $compose_files run --rm $tty_flag dev shell || sh_rc=$?
      exit "$sh_rc"
    fi
    # shellcheck disable=SC2086
    exec docker compose -p "autonomous-$segment" $compose_files \
      run --rm --service-ports $tty_flag dev shell
    ;;
  console | release)
    service="$cmd"
    image="$DEV_IMAGE"
    [ "$service" = release ] && image="$RELEASE_IMAGE"
    resolve_target
    require_image "$image"

    lookup_service="dev"
    [ "$service" = release ] && lookup_service="release"
    identity="$(lookup_identity "$lookup_service")" || die 1 "could not derive the instance identity for $target"
    segment="$(env_value "$identity" AUTONOMOUS_INSTANCE_SEGMENT)"
    node_name="$(env_value "$identity" AUTONOMOUS_NODE_NAME)"
    [ -n "$segment" ] || die 1 "could not derive the instance identity for $target"

    project="autonomous-$segment"
    [ "$with_docker" != 1 ] || engine_preconditions "$image"
    volumes_prepare "$image"
    # `up -d` would recreate a running instance of this project with the new port
    # and silently replace it; refuse instead (the entrypoint lock covers the
    # other-project case, FR-018a).
    live="$(docker ps --filter "label=com.docker.compose.project=$project" --format '{{.Names}}' | head -n1)"
    if [ -n "$live" ]; then
      owner="$(python3 - "$state_root/instances/$segment/instance.json" <<'PY' 2>/dev/null || true
import json, sys
o = json.load(open(sys.argv[1]))
print("%s/%s since %s" % (o.get("compose_project", "?"), o.get("service", "?"), o.get("started_at", "?")))
PY
)"
      die 75 "target $target is already served by ${owner:-$live}"
    fi

    choose_port
    print_summary
    volumes_apply "$image"

    if [ "$with_docker" = 1 ]; then
      engine_overlay
      engine_up "$project"
    fi

    # A port taken between the check above and the bind is translated too (76).
    # shellcheck disable=SC2086
    if ! up_out="$(docker compose -p "$project" $compose_files up -d --no-build --pull never "$service" 2>&1)"; then
      if printf '%s' "$up_out" | grep -Eqi 'port is already allocated|address already in use'; then
        die 76 "console port $port is already in use on 127.0.0.1"
      fi
      printf '%s\n' "$up_out" >&2
      if [ "$with_docker" = 1 ]; then
        # shellcheck disable=SC2086
        docker compose -p "$project" $compose_files down >/dev/null 2>&1 || true
      fi
      die 1 "could not start the $service for $target"
    fi
    wait_for_console "$project" "$service"
    say "console ready at http://127.0.0.1:$port/"
    ;;

  remote)
    resolve_target
    require_image "$RELEASE_IMAGE"

    identity="$(lookup_identity release)" || die 1 "could not derive the instance identity for $target"
    segment="$(env_value "$identity" AUTONOMOUS_INSTANCE_SEGMENT)"
    [ -n "$segment" ] || die 1 "could not derive the instance identity for $target"

    project="autonomous-$segment"
    # shellcheck disable=SC2086
    running="$(docker compose -p "$project" $compose_files ps -q release 2>/dev/null | head -n1)"
    [ -n "$running" ] || die 1 "no running release for $target; start it with scripts/autonomous release --target $target"

    # `exec` sees the container's configured environment, not what the entrypoint
    # exported, so hand the derived node name and cookie path to `remote`.
    env_flags=""
    for line in $identity; do env_flags="$env_flags -e $line"; done
    tty_flag=""
    [ -t 0 ] || tty_flag="-T"
    # shellcheck disable=SC2086
    exec docker compose -p "$project" $compose_files exec $tty_flag $env_flags release /app/bin/autonomous remote
    ;;

  port)
    resolve_target
    require_image "$DEV_IMAGE"

    identity="$(lookup_identity)" || die 1 "could not derive the instance identity for $target"
    segment="$(env_value "$identity" AUTONOMOUS_INSTANCE_SEGMENT)"
    [ -n "$segment" ] || die 1 "could not derive the instance identity for $target"

    # Any running container of the project publishes 4000: the agent service, or with
    # --docker (feature 046) the engine sidecar that owns the shared network namespace.
    cids="$(docker ps -q --filter "label=com.docker.compose.project=autonomous-$segment")"
    [ -n "$cids" ] || die 1 "no running instance for $target"
    published=""
    for cid in $cids; do
      published="$(docker port "$cid" 4000/tcp 2>/dev/null | head -n1)"
      [ -z "$published" ] || break
    done
    [ -n "$published" ] || die 1 "instance for $target publishes no console port"
    say "console  http://${published}/"
    ;;

  viewer)
    resolve_target
    require_image "$DEV_IMAGE"

    identity="$(lookup_identity)" || die 1 "could not derive the instance identity for $target"
    segment="$(env_value "$identity" AUTONOMOUS_INSTANCE_SEGMENT)"
    [ -n "$segment" ] || die 1 "could not derive the instance identity for $target"

    cids="$(docker ps -q --filter "label=com.docker.compose.project=autonomous-$segment")"
    [ -n "$cids" ] || die 1 "no running instance for $target"
    published=""
    for cid in $cids; do
      published="$(docker port "$cid" 6080/tcp 2>/dev/null | head -n1)"
      [ -z "$published" ] || break
    done
    [ -n "$published" ] || die 1 "instance for $target publishes no viewer; start it with --viewer"
    say "viewer   http://${published}/vnc.html"
    ;;
esac
